# Profiles are user data, not source. Saved profiles live in IndexedDB; these are
# the copies Export and the optional mirror folder write out.
homescreen-*.json
*-profile.json
profiles/

# Chrome Web Store build artefacts: the zip and resized listing images are
# generated from what is already tracked.
store/*.zip
store/*.png

# Full-resolution screenshot originals: the sized copies in media/ are what ship.
screenshots-full/
